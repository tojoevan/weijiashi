/* 事务页：空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 80rpx;
  text-align: center;
}
.empty .e-t {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}
.empty .e-s {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-tertiary);
}
