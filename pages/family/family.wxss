/* 家庭页专属样式（共享列表 + 成员 + 邀请） */
.invite-banner {
  margin: 0 40rpx;
  display: flex; align-items: center; gap: 24rpx;
  background: linear-gradient(135deg, var(--brand-soft, #EFE7DA), var(--surface));
  border: 2rpx solid var(--brand-border, #E3D6C2);
  border-radius: 28rpx; padding: 26rpx 28rpx;
}
.invite-banner .ib-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.invite-banner .ib-title { font-size: 27rpx; font-weight: 600; color: var(--text-primary); }
.invite-banner .ib-sub { font-size: 21rpx; color: var(--text-tertiary); }
.invite-banner .ib-actions { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.invite-banner .ib-btn {
  font-size: 24rpx; font-weight: 500; padding: 0 26rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center; border-radius: 999rpx;
}
.invite-banner .ib-btn.ghost { color: var(--text-secondary); background: var(--surface-muted); }
.invite-banner .ib-btn.solid { color: #fff; background: var(--brand); }

.member-row .avatar.img { width: 84rpx; height: 84rpx; border-radius: 50%; }
.member-row .avatar.self { background: var(--brand); color: var(--on-brand, #fff); }
.member-row .avatar.family { background: var(--family, #7A8471); color: #fff; }

.invite-share {
  margin: 28rpx 40rpx 0;
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  height: 96rpx; border-radius: 28rpx;
  background: var(--surface); border: 2rpx solid var(--border-subtle);
  font-size: 29rpx; font-weight: 600; color: var(--brand);
  line-height: normal; padding: 0; text-align: center;
}
.invite-share::after { border: none; }
.invite-share .iic.share { background: var(--brand); }
.invite-share .it { color: var(--brand); }
.copy-link {
  margin: 18rpx 40rpx 0; text-align: center;
  font-size: 23rpx; color: var(--text-tertiary);
}

.share-list { padding: 0 40rpx; margin-top: 24rpx; }
.share-row {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--surface); border: 2rpx solid var(--border-subtle);
  border-radius: 28rpx; height: 112rpx; padding: 0 28rpx; margin-top: 20rpx;
}
.share-row:active { background: var(--surface-muted); }
.share-row .dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.share-row .dot.brand { background: var(--brand); }
.share-row .dot.family { background: var(--family); }
.share-row .sr-body { flex: 1; display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.share-row .sr-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.share-row .sr-title {
  font-size: 28rpx; font-weight: 500; color: var(--text-primary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.share-row .sr-sharer { font-size: 21rpx; color: var(--text-tertiary); }
.share-row .sr-tag {
  flex-shrink: 0; background: var(--surface-muted); border-radius: var(--r-chip);
  padding: 0 16rpx; height: 40rpx; display: flex; align-items: center;
  font-size: 20rpx; font-weight: 500; color: var(--text-secondary);
}
.share-row .sr-arrow {
  flex-shrink: 0; width: 14rpx; height: 14rpx;
  border-top: 3rpx solid var(--text-tertiary); border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
}
.share-empty {
  margin-top: 24rpx; padding: 36rpx 28rpx;
  background: var(--surface-muted); border-radius: 32rpx;
  font-size: 24rpx; color: var(--text-tertiary); text-align: center;
  line-height: 36rpx;
}

/* 家庭切换器（多家庭） */
.fam-switch {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  margin: 28rpx 40rpx 0;
}
.fam-chip {
  padding: 0 28rpx; height: 68rpx; border-radius: 28rpx;
  display: flex; align-items: center; font-size: 25rpx; font-weight: 500;
  background: var(--surface); color: var(--text-secondary);
  border: 2rpx solid var(--border-subtle);
}
.fam-chip.active {
  background: var(--brand-soft, #EFE7DA); color: var(--brand);
  border-color: var(--brand-border, #E3D6C2);
}
.fam-chip.add {
  color: var(--text-tertiary);
  border-style: dashed; border-color: var(--border-subtle);
  background: transparent;
}

/* 退出 / 转让并退出 */
.leave-btn {
  margin: 32rpx 40rpx 0; height: 84rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; color: var(--danger, #C0392B);
  background: var(--surface-muted);
}
.leave-btn:active { opacity: .7; }

.empty-tip {
  margin: 60rpx 40rpx 0; text-align: center;
  font-size: 27rpx; color: var(--text-tertiary);
  display: flex; flex-direction: column; align-items: center;
}

/* 共享项详情弹层 */
.sd-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.45); display: flex; align-items: flex-end;
  z-index: 50;
}
.sd-card {
  width: 100%; background: var(--bg, #FAFAF7); border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex; flex-direction: column; gap: 20rpx;
}
.sd-head { display: flex; align-items: center; gap: 18rpx; }
.sd-head .sd-ic { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.sd-head .sd-ic image { width: 100%; height: 100%; }
.sd-title {
  flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; color: var(--text-primary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.sd-close {
  flex-shrink: 0; width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--surface-muted); color: var(--text-secondary);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx; line-height: 1;
}
.sd-meta { display: flex; align-items: center; gap: 16rpx; }
.sd-sharer { font-size: 22rpx; color: var(--text-tertiary); }
.sd-tag {
  background: var(--surface-muted); border-radius: var(--r-chip);
  padding: 0 16rpx; height: 40rpx; display: flex; align-items: center;
  font-size: 20rpx; font-weight: 500; color: var(--text-secondary);
}
.sd-text {
  font-size: 27rpx; color: var(--text-secondary); line-height: 42rpx;
  white-space: pre-wrap; word-break: break-word;
}
.sd-photos { display: flex; flex-wrap: wrap; gap: 14rpx; }
.sd-photo { width: 160rpx; height: 160rpx; border-radius: 18rpx; background: var(--surface-muted); }
.sd-due { font-size: 22rpx; color: var(--text-tertiary); }
