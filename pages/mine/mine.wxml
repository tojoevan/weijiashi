<view class="screen" style="{{themeStyle}}">
  <view class="status-bar">
    <text class="time">9:41</text>
    <view class="status-icons">
      <view class="signal"><i></i><i></i><i></i><i></i></view>
      <view class="wifi"></view>
      <view class="bat"><i></i></view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view style="height:36rpx"></view>

    <!-- 首启资料引导卡：非阻塞、可关闭 -->
    <view wx:if="{{showProfileHint}}" class="hint-card">
      <view class="hc-body">
        <text class="hc-title">完善头像和昵称</text>
        <text class="hc-sub">家庭成员分享时更易认出你</text>
      </view>
      <view class="hc-actions">
        <view class="hc-later" bindtap="onDismissProfileHint">稍后</view>
        <view class="hc-go" bindtap="onFillProfile">去完善</view>
      </view>
    </view>

    <!-- 资料卡 -->
    <view class="profile-mini {{isSet ? '' : 'pending'}} {{highlightProfile ? 'hl' : ''}}">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"/>
        <view wx:else class="avatar-img placeholder">{{avatarChar}}</view>
        <view class="avatar-badge">改</view>
      </button>
      <view class="pm-text">
        <input class="pm-name-input" type="nickname" placeholder="点击填写昵称" placeholder-class="pm-ph"
               value="{{nickname}}" bindblur="onNicknameBlur" bindinput="onNicknameInput" confirm-type="done"/>
        <text class="pm-sub">{{isSet ? '个人空间 · 已完善资料' : '点头像选头像，填昵称即可'}}</text>
      </view>
      <view wx:if="{{!isSet}}" class="pm-cta">待完善</view>
    </view>

    <!-- 空间切换 -->
    <view class="space-switch" style="margin-top:30rpx">
      <view class="space-seg {{space==='personal'?'active':''}}" bindtap="setSpace" data-s="personal"><view class="dot brand"></view><text>个人空间</text></view>
      <view class="space-seg {{space==='family'?'active':''}}" bindtap="setSpace" data-s="family"><view class="dot family"></view><text>家庭空间</text></view>
    </view>

    <!-- 统计（真实数据） -->
    <view class="stats" style="margin-top:30rpx;border:2rpx solid var(--border-subtle)">
      <view class="stat"><text class="n">{{stats.todo}}</text><text class="l">待办</text></view>
      <view class="stat"><text class="n dark">{{stats.archive}}</text><text class="l">档案</text></view>
      <view class="stat"><text class="n dark">{{stats.record}}</text><text class="l">记录</text></view>
    </view>

    <!-- 设置 -->
    <view class="section-title" style="margin-top:30rpx">
      <text class="t">设置</text>
    </view>

    <view class="menu-row form" style="margin-top:30rpx" bindtap="go" data-p="theme">
      <view class="m-ic"><image src="{{icons.menuTheme}}"/></view>
      <text class="m-txt">主题设置</text>
      <image class="m-chev" src="{{icons.chev}}"/>
    </view>
    <view class="menu-row form" style="margin-top:30rpx" bindtap="go" data-p="family">
      <view class="m-ic"><image src="{{icons.menuFam}}"/></view>
      <text class="m-txt">家庭成员</text>
      <image class="m-chev" src="{{icons.chev}}"/>
    </view>
    <view class="menu-row form" style="margin-top:30rpx" bindtap="go" data-p="tag">
      <view class="m-ic"><image src="{{icons.menuTag}}"/></view>
      <text class="m-txt">标签管理</text>
      <image class="m-chev" src="{{icons.chev}}"/>
    </view>
    <view class="menu-row form" style="margin-top:30rpx" bindtap="go" data-p="about">
      <view class="m-ic"><image src="{{icons.menuAbout}}"/></view>
      <text class="m-txt">关于微家事</text>
      <image class="m-chev" src="{{icons.chev}}"/>
    </view>

    <view style="height:220rpx"></view>
  </scroll-view>

  <view class="tabbar">
    <view class="capsule">
      <view class="seg {{selected===0?'active':''}}" bindtap="go" data-p="today"><image class="ic" src="{{icons.tabToday}}"/><text class="lb">今天</text></view>
      <view class="seg {{selected===1?'active':''}}" bindtap="go" data-p="tasks"><image class="ic" src="{{icons.tabTasks}}"/><text class="lb">事务</text></view>
      <view class="seg {{selected===2?'active':''}}" bindtap="go" data-p="archive"><image class="ic" src="{{icons.tabArchive}}"/><text class="lb">档案</text></view>
      <view class="seg {{selected===3?'active':''}}" bindtap="go" data-p="mine"><image class="ic" src="{{icons.tabMine}}"/><text class="lb">我的</text><view wx:if="{{mineBadge}}" class="tab-badge"></view></view>
    </view>
  </view>
</view>
